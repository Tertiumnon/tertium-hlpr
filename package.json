{
  "name": "@tertium/hlpr",
  "version": "0.25.6",
  "description": "Useful CLI commands with natural, consistent names for everyday tasks across Windows, macOS, and Linux",
  "author": "Vitalii Balabanov",
  "email": "tertiumnon@gmail.com",
  "main": "bin/index.js",
  "type": "module",
  "scripts": {
    "build:main": "bun build ./src/index.ts --outfile ./bin/index.js --target node",
    "build:commands": "bun scripts/build-commands/build-commands.ts",
    "build": "bun run build:main && bun run build:commands",
    "test": "bun test",
    "lint": "biome lint src scripts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun scripts/test-rename/test-rename.ts",
    "prepublishOnly": "bun run build",
    "release:patch": "gith release --patch",
    "release:minor": "gith release --minor",
    "release:major": "gith release --major",
    "version": "gith changelog --no-commit && git add CHANGELOG.md",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3"
  },
  "bin": {
    "hlpr": "./bin/index.js"
  },
  "files": [
    "bin",
    "package.json"
  ],
  "keywords": [
    "cli",
    "utility",
    "shell",
    "scripts"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tertiumnon/tertium-hlpr.git"
  },
  "license": "MIT"
}
